# 本文件由 deploy.sh 从 site.conf.template 生成，请勿手工修改。
# 修改模板后执行 ./deploy.sh update 或 ./deploy.sh recover 重新生成。
#
# 统一 HTTPS 入口：只暴露 80/443；ARTEX Web/API 固定走宿主机回环 127.0.0.1:8787。
# SSE 必须关闭缓冲并放宽读超时，否则活动流会一直转圈。

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

server {
    listen 80 default_server;
#__IF_IPV6__
    listen [::]:80 default_server;
#__ENDIF__
    server_name __ARTEX_DOMAIN__;
    server_tokens off;

    # Nginx 自身健康检查（容器 healthcheck / 外部探活使用），不经过 ARTEX。
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # 预留给 ACME HTTP-01；使用自签名证书时无影响。
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl default_server;
#__IF_IPV6__
    listen [::]:443 ssl default_server;
#__ENDIF__
    http2 on;
    server_name __ARTEX_DOMAIN__;
    server_tokens off;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:ARTEX_SSL:10m;
    ssl_session_timeout 1d;

    add_header X-Content-Type-Options nosniff always;
    client_max_body_size 512m;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_connect_timeout 10s;
    }
}
