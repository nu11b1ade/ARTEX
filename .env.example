# Docker 部署配置（复制为 .env）
# 本仓库发布的 Docker Hub 镜像地址；参见 README 的部署说明。
ARTEX_IMAGE=nullblade/artex
ARTEX_TAG=latest
POSTGRES_USER=artex
# 会嵌入 PostgreSQL DSN：仅使用字母、数字和 . _ ~ -（deploy.sh 会校验并自动生成）
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# ── 生产部署（./deploy.sh + deploy/docker-compose.host.yml）──────────────
# Bridge 部署（docker-compose.yml）会忽略以下配置。
# 访问域名；留空则使用自签名证书并通过服务器 IP 访问。
ARTEX_DOMAIN=
# PostgreSQL 在宿主机回环上的端口；留空由 deploy.sh 自动选择空闲端口。
# ARTEX_PG_PORT=5432
# 复用已有 PostgreSQL 数据卷名；默认 artex-host-pgdata。
# ARTEX_PG_VOLUME=artex-host-pgdata
# 运行状态卷（JWT 签名密钥等）；保留它，更新后无需重新登录。默认 artex-host-state。
# ARTEX_STATE_VOLUME=artex-host-state
# 首次启动时种入的 HTTP Basic Auth 凭据；数据库已有配置时不再覆盖。
# deploy.sh 会自动生成并写入这两项，手工启动 Compose 时必须自行设置。
# ARTEX_BASIC_AUTH_USER=admin
# ARTEX_BASIC_AUTH_PASSWORD=

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
